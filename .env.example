# Configurações do banco de dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres?schema=public"

# Ambiente: development → usa WPPConnect | production → usa Meta API
NODE_ENV=production

# Porta do servidor Express 
PORT=3000

# URL base para requisições externas (httpService)
API_BASE_URL=http://localhost:8000/homologation-api-chatboot-proxy/chatboot/
REQ1=finalizaConversa
REQ2=salvaRespostaNps

#Configurações BOT
# Modo de teste: se 'true', o bot responde APENAS ao número BOT_NUMERO_ADMIN
BOT_NUMERO_ADMIN=5514999999999
BOT_MODO_TESTE=true
BOT_LID_ADMIN=000000000000000

# Máquina de estados padrão (sem banco de dados)
# true  → usa o fluxo em memória — ideal para testes
# false → usa os fluxos configurados no banco de dados (padrão de produção)
BOT_STATE_MACHINE_PADRAO=false

#META
# TOKEN DE ACESSO DA PÁGINA: META_ACCESS_TOKEN
# VERIFY_TOKEN: token de verificação do webhook (configurado no painel da Meta)
META_ACCESS_TOKEN=your_meta_access_token
VERIFY_TOKEN=your_verify_token

# Configurações do Redis
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
REDIS_HOST=localhost
